# Copy this file to .env (git-ignored) and fill in what you need. Docker Compose reads it.
# Placeholders only: never put real keys in this file. Everything is optional locally.

# Apify: fetching reels and transcripts (costs Apify credit). Without it, fetches fail clearly.
APIFY_TOKEN=apify_api_your-token-here
# Fetch transcripts automatically after each fetch (each costs about $0.05). true or false.
AUTO_TRANSCRIBE=true

# The account that owns the app: free, no limits, the Admin panel. Locally: owner@example.com.
OWNER_EMAIL=owner@example.com

# OpenAI: hooks, scripts, translations and remixes. Without it transcripts wait for the AI.
OPENAI_API_KEY=sk-your-key-here

# Stripe (use TEST keys locally: sk_test_..., and the signing secret of a test webhook).
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# Resend: sign-in e-mails. Without it the 6-digit code is printed in `docker compose logs web`.
RESEND_API_KEY=re_your-key-here

# Telegram sign-in through a bot from @BotFather (needs a public HTTPS address for its webhook).
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-here
